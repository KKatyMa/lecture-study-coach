# Optional server-side defaults (not secrets)
# Never commit .env.local — it is gitignored.

# Default Groq model id when the client does not override it (not secret)
GROQ_MODEL=qwen/qwen3.8-27b

# Optional server-side keys for non-Groq providers only (Groq uses BYOK in the browser)
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# LLM_API_KEY=

# Optional Ollama overrides
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:14b
